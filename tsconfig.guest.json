{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/guest",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "declaration": false,
    "declarationMap": false
  },
  "include": ["guest/**/*.ts", "shared/**/*.ts"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}
