# Havvn reads these at startup via dotenv (electron/main.ts). All are optional —
# the app runs fine with none of them set. They exist for development and testing.

# Run a second, isolated instance alongside your main one (separate store and
# window title). Any non-empty label works.
# TH_INSTANCE=dev

# Force the torrent engine instead of using the stored setting.
# HAVVN_ENGINE=transmission

# Open DevTools on the main window at startup.
# HAVVN_DEVTOOLS=1

# Replace the public WebRTC rendezvous trackers (comma-separated), so two local
# instances can find each other with no public infrastructure in the loop.
# Outranks the Settings → Sharing tracker list, so a stored setting can't pull a
# dev instance back onto public trackers.
# HAVVN_ROOM_TRACKERS=ws://127.0.0.1:8009
