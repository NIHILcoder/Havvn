{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist/electron",
    "rootDir": ".",
    "module": "NodeNext",
    "moduleResolution": "NodeNext"
  },
  "include": [
    "electron/**/*.ts",
    "shared/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "renderer",
    "**/*.test.ts"
  ]
}
