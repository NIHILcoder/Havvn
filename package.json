{
  "name": "havvn",
  "version": "3.0.6",
  "description": "A modern, privacy-focused BitTorrent client",
  "main": "dist/electron/electron/main.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:electron\" \"npm run dev:renderer\"",
    "dev:electron": "tsc -p tsconfig.electron.json && cross-env NODE_ENV=development electron .",
    "dev:renderer": "webpack serve --config webpack.renderer.config.js --mode development",
    "build": "npm run build:electron && npm run build:renderer && npm run build:guest",
    "build:electron": "tsc -p tsconfig.electron.json",
    "build:renderer": "webpack --config webpack.renderer.config.js --mode production",
    "build:guest": "webpack --config webpack.guest.config.js --mode production",
    "typecheck": "npm run typecheck:electron && npm run typecheck:renderer && npm run typecheck:guest",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "typecheck:renderer": "tsc -p tsconfig.renderer.json --noEmit",
    "typecheck:guest": "tsc -p tsconfig.guest.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint \"electron/**/*.ts\" \"renderer/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"guest/**/*.ts\"",
    "lint:fix": "eslint \"electron/**/*.ts\" \"renderer/**/*.{ts,tsx}\" \"shared/**/*.ts\" \"guest/**/*.ts\" --fix",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,yml,yaml}\"",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win",
    "prepare": "husky",
    "security:audit": "npm audit --audit-level=high",
    "security:fix": "npm audit fix",
    "security:snyk": "snyk test --severity-threshold=high",
    "spike:engine": "npm run build:electron && node dist/electron/electron/torrent/native/spike-harness.js",
    "spike:lan": "npm run build:electron && node dist/electron/electron/lan/spike-harness.js",
    "spike:pipe": "npm run build:electron && node dist/electron/electron/lan/pipe-spike.js"
  },
  "dependencies": {
    "@fontsource/chakra-petch": "^5.3.0",
    "@fontsource/exo-2": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@silentbot1/nat-api": "0.4.9",
    "@tanstack/react-virtual": "^3.14.13",
    "@types/webtorrent": "^3.0.0",
    "bittorrent-tracker": "^11.2.3",
    "chromecast-api": "^0.4.2",
    "d3-geo": "^3.1.1",
    "dotenv": "^17.4.2",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.8.9",
    "ffmpeg-static": "^5.3.0",
    "hls.js": "^1.7.3",
    "ip3country": "^5.0.0",
    "koffi": "^2.12.0",
    "nat-pmp": "^1.0.0",
    "parse-torrent": "9.1.5",
    "protobufjs": "^8.8.0",
    "qrcode": "^1.5.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hot-toast": "^2.6.0",
    "uiohook-napi": "^1.5.5",
    "uuid": "^14.0.2",
    "webtorrent": "3.0.21",
    "zustand": "^4.5.0"
  },
  "overrides": {
    "debug": "^4.3.7",
    "ip": "npm:@webpod/ip@0.6.1",
    "dns-packet": "^5.6.1",
    "castv2": "^0.1.10",
    "castv2-client": "^1.2.0",
    "protobufjs": "$protobufjs",
    "xml2js@<0.5.0": "^0.6.2"
  },
  "optionalDependencies": {
    "utp-native": "^2.5.3"
  },
  "devDependencies": {
    "@jitsi/rnnoise-wasm": "^0.2.1",
    "@types/d3-geo": "^3.1.1",
    "@types/node": "^24.13.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.2.42",
    "@types/react-dom": "^18.2.17",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "css-loader": "^7.1.5",
    "electron": "^44.4.2",
    "electron-builder": "^26.15.3",
    "eslint": "^8.55.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "html-webpack-plugin": "^5.6.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "prettier": "^3.4.2",
    "snyk": "^1.1307.2",
    "style-loader": "^3.3.3",
    "ts-loader": "^9.6.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.2",
    "vitest": "^4.1.9",
    "webpack": "^5.111.0",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.0.0"
  },
  "build": {
    "appId": "com.torrenthunt.app",
    "productName": "Havvn",
    "copyright": "Copyright © 2026 Havvn",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "NIHILcoder",
        "repo": "Havvn",
        "releaseType": "prerelease"
      }
    ],
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "**/node_modules/ffmpeg-static/**",
      "**/node_modules/utp-native/**",
      "**/node_modules/uiohook-napi/**",
      "**/node_modules/koffi/**",
      "**/node_modules/node-datachannel/**"
    ],
    "fileAssociations": [
      {
        "ext": "torrent",
        "name": "BitTorrent Document",
        "description": "Open with Havvn",
        "role": "Editor",
        "icon": "build/icon2.ico"
      }
    ],
    "protocols": [
      {
        "name": "magnet",
        "schemes": [
          "magnet"
        ]
      },
      {
        "name": "Havvn room invite",
        "schemes": [
          "havvn"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Havvn-${version}-win-portable.${ext}",
      "icon": "build/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "extraFiles": [
      {
        "from": "build/icon2.ico",
        "to": "icon2.ico"
      }
    ],
    "extraResources": [
      {
        "from": "build/icon.ico",
        "to": "icon.ico"
      },
      {
        "from": "vendor/transmission/win32-x64",
        "to": "engine"
      },
      {
        "from": "vendor/wintun/win32-x64",
        "to": "wintun"
      }
    ],
    "nsis": {
      "artifactName": "Havvn-Setup-${version}.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Havvn",
      "include": "build/installer.nsh",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerSidebar": "build/installerSidebar.bmp",
      "uninstallerSidebar": "build/uninstallerSidebar.bmp",
      "installerHeader": "build/installerHeader.bmp",
      "installerLanguages": [
        "en_US",
        "ru_RU"
      ],
      "multiLanguageInstaller": true
    }
  },
  "author": {
    "name": "NIHILcoder"
  },
  "license": "MIT"
}
